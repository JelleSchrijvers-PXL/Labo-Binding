<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ActorsApplication.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:ActorsApplication.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="ActorsApplication">

    <Shell.FlyoutHeader>
        <Grid Padding="30" BackgroundColor="Black">
            <Label Text="Actors Application"
                   TextColor="White"
                   FontSize="Large"
                   HorizontalOptions="Center"/>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Actors">
        <ShellContent
            Title="Actors of the day"
            ContentTemplate="{DataTemplate pages:ActorsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="About">
        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate pages:AboutPage}"/>
    </FlyoutItem>

</Shell>
